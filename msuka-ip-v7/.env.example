# MSUkaIP — environment configuration
# Copy this file to `.env` (in the same folder as server.js) and fill in real values.
# The server loads this automatically on startup — no extra package required.

# ── Secrets (REQUIRED for LAN / defense deployment) ─────────────────────────
# Generate strong random values, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | %{ Get-Random -Maximum 256 }))
JWT_SECRET=change-me-to-a-long-random-string
AES_SECRET=change-me-to-another-long-random-string
AES_SALT=change-me-too

# ── SQLite database ─────────────────────────────────────────────────────────
# Optional — defaults to ./msukaip.db next to server.js. WAL mode and
# foreign_keys are enabled automatically (see db.js).
#SQLITE_PATH=C:\path\to\msukaip.db

# ── Legacy MySQL connection (only used by scripts/migrate-mysql-to-sqlite.js) ─
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=msukaip

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# HTTPS port for voice calls from LAN clients (browsers require a secure
# origin for microphone access). A self-signed cert is generated into certs/
# on first run.
HTTPS_PORT=3443
